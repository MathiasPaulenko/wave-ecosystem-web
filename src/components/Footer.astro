---
const year = new Date().getFullYear();
const repos = [
  { name: 'cdpwave', url: 'https://github.com/MathiasPaulenko/cdpwave' },
  { name: 'bidiwave', url: 'https://github.com/MathiasPaulenko/bidiwave' },
  { name: 'wavexis', url: 'https://github.com/MathiasPaulenko/wavexis' },
  { name: 'wavexis-mcp', url: 'https://github.com/MathiasPaulenko/wavexis-mcp' },
];
---

<footer class="relative overflow-hidden border-t border-slate-800/50 py-16">
  <!-- Background wave -->
  <div class="absolute bottom-0 left-0 right-0 pointer-events-none opacity-30">
    <svg viewBox="0 0 1440 200" class="w-full h-auto" preserveAspectRatio="none" fill="none">
      <path d="M0,100 C240,140 480,60 720,100 C960,140 1200,60 1440,100 L1440,200 L0,200 Z" fill="rgba(34, 211, 238, 0.03)" />
      <path d="M0,130 C240,170 480,90 720,130 C960,170 1200,90 1440,130 L1440,200 L0,200 Z" fill="rgba(52, 211, 153, 0.02)" />
    </svg>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- CTA banner -->
    <div class="reveal mb-12 rounded-2xl border border-wave-500/15 bg-gradient-to-br from-abyss-800/60 to-abyss-900/60 p-8 text-center backdrop-blur-sm sm:p-12">
      <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">
        Únete al ecosistema <span class="text-gradient-wave">Wave</span>
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-400">
        Contribuye con código, reporta bugs, sugiere features o simplemente dale una estrella.
        Toda ayuda es bienvenida.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="https://github.com/MathiasPaulenko/wave-ecosystem-web#readme"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-wave-500 to-foam-400 px-6 py-3 text-sm font-semibold text-abyss-950 transition-transform hover:scale-105"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.72-4.04-1.59-4.04-1.59-.55-1.38-1.34-1.75-1.34-1.75-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.23 1.84 1.23 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.84 0-1.29.47-2.34 1.23-3.17-.12-.3-.53-1.52.12-3.16 0 0 1-.32 3.3 1.21a11.6 11.6 0 0 1 6 0c2.3-1.53 3.3-1.21 3.3-1.21.65 1.64.24 2.86.12 3.16.77.83 1.23 1.88 1.23 3.17 0 4.54-2.81 5.53-5.49 5.83.43.36.81 1.08.81 2.18 0 1.58-.01 2.85-.01 3.24 0 .32.21.7.82.58A12.04 12.04 0 0 0 24 12.29C24 5.78 18.63.5 12 .5Z" /></svg>
          Ver en GitHub
        </a>
        <a
          href="#tools"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-700 px-6 py-3 text-sm font-semibold text-slate-300 transition-colors hover:border-wave-500/30 hover:text-wave-400"
        >
          Explorar herramientas
        </a>
      </div>
    </div>

    <!-- Links grid -->
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <a href="#" class="flex items-center gap-2.5">
          <svg class="h-7 w-7" viewBox="0 0 64 64" fill="none">
            <path d="M8 40 Q16 30 24 40 T40 40 T56 40" stroke="#22d3ee" stroke-width="3" stroke-linecap="round" fill="none" />
            <path d="M8 46 Q16 36 24 46 T40 46 T56 46" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.6" />
            <circle cx="32" cy="20" r="6" fill="#22d3ee" />
            <circle cx="32" cy="20" r="3" fill="#050d1c" />
          </svg>
          <span class="font-display text-base font-extrabold text-white">wave<span class="text-wave-400">.</span></span>
        </a>
        <p class="mt-3 text-sm text-slate-500">
          Ecosistema de automatización de navegador para Python.
        </p>
      </div>

      <div>
        <h4 class="font-display text-xs font-semibold uppercase tracking-wider text-slate-400">Repositorios</h4>
        <ul class="mt-4 space-y-2.5">
          {repos.map((repo) => (
            <li>
              <a href={repo.url} target="_blank" rel="noopener" class="text-sm text-slate-500 transition-colors hover:text-wave-400">
                {repo.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-display text-xs font-semibold uppercase tracking-wider text-slate-400">Navegación</h4>
        <ul class="mt-4 space-y-2.5">
          <li><a href="#tools" class="text-sm text-slate-500 transition-colors hover:text-wave-400">Herramientas</a></li>
          <li><a href="#compare" class="text-sm text-slate-500 transition-colors hover:text-wave-400">Comparativa</a></li>
          <li><a href="#usecases" class="text-sm text-slate-500 transition-colors hover:text-wave-400">Casos de uso</a></li>
          <li><a href="#architecture" class="text-sm text-slate-500 transition-colors hover:text-wave-400">Arquitectura</a></li>
          <li><a href="#roadmap" class="text-sm text-slate-500 transition-colors hover:text-wave-400">Roadmap</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display text-xs font-semibold uppercase tracking-wider text-slate-400">Comunidad</h4>
        <ul class="mt-4 space-y-2.5">
          <li><a href="https://github.com/MathiasPaulenko/wave-ecosystem-web#readme" target="_blank" rel="noopener" class="text-sm text-slate-500 transition-colors hover:text-wave-400">GitHub</a></li>
          <li><a href="https://pypi.org/user/MathiasPaulenko/" target="_blank" rel="noopener" class="text-sm text-slate-500 transition-colors hover:text-wave-400">PyPI</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-800/50 pt-8 sm:flex-row">
      <p class="text-xs text-slate-600">
        © {year} Wave Ecosystem · Hecho con Python, Astro y Tailwind CSS
      </p>
      <div class="flex items-center gap-2 text-xs text-slate-600">
        <span class="h-1.5 w-1.5 rounded-full bg-foam-400 animate-glow-pulse"></span>
        <span>Open Source · MIT License</span>
      </div>
    </div>
  </div>
</footer>
