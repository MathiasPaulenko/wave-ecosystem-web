---
import { aiResources } from '../data/content';

const accentMap = {
  wave: { text: 'text-wave-400', bg: 'bg-wave-500/10', border: 'border-wave-500/20', glow: 'shadow-wave-500/20' },
  foam: { text: 'text-foam-400', bg: 'bg-foam-400/10', border: 'border-foam-400/20', glow: 'shadow-foam-400/20' },
  coral: { text: 'text-coral-400', bg: 'bg-coral-500/10', border: 'border-coral-500/20', glow: 'shadow-coral-500/20' },
};

const totalResources = aiResources.reduce((sum, g) => sum + g.resources.length, 0);
---

<section id="ai-resources" class="relative py-24 sm:py-32">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-abyss-900/30 to-transparent"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-coral-400" data-i18n-es="Toolkit IA">AI Toolkit</span>
      <h2 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl" data-i18n-es="Recursos IA para el ecosistema">
        AI resources for the ecosystem
      </h2>
      <p class="mt-4 text-lg text-slate-400" data-i18n-es="Skills, agentes, reglas y workflows pre-construidos para Claude, Cursor y Windsurf. {totalResources} recursos que extienden el ecosistema Wave a tu flujo de trabajo con IA.">
        Skills, agents, rules and workflows pre-built for Claude, Cursor and Windsurf.
        {totalResources} resources that extend the Wave ecosystem to your AI workflow.
      </p>
    </div>

    <!-- Resource groups -->
    <div class="mt-16 grid gap-6 lg:grid-cols-2">
      {aiResources.map((group, i) => {
        const a = accentMap[group.accent];
        return (
          <div
            class={`reveal glass group rounded-2xl p-6 transition-all duration-300 hover:shadow-2xl ${a.glow} hover:-translate-y-1`}
            style={`transition-delay: ${i * 80}ms;`}
          >
            <!-- Header -->
            <div class="flex items-center gap-4">
              <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl ${a.bg} border ${a.border} text-2xl`}>
                {group.icon}
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-3">
                  <h3 class="font-display text-lg font-bold text-white" data-i18n-es={group.title.es}>{group.title.en}</h3>
                  <span class={`rounded-full ${a.bg} border ${a.border} px-2.5 py-0.5 text-xs font-medium ${a.text}`}>
                    {group.resources.length}
                  </span>
                </div>
                <p class="mt-1 text-sm text-slate-400" data-i18n-es={group.description.es}>{group.description.en}</p>
              </div>
            </div>

            <!-- Resource list -->
            <div class="mt-5 flex flex-wrap gap-2">
              {group.resources.map((res) => (
                <a
                  href={res.url}
                  target="_blank"
                  rel="noopener"
                  class={`inline-flex items-center gap-1.5 rounded-lg ${a.bg} border ${a.border} px-3 py-1.5 font-mono text-xs ${a.text} transition-all hover:scale-105 hover:border-opacity-40`}
                >
                  {res.name}
                  <svg class="h-3 w-3 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Repo link -->
    <div class="reveal mt-10 text-center">
      <a
        href="https://github.com/MathiasPaulenko/ai-toolkit"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-xl border border-coral-500/20 bg-coral-500/5 px-6 py-3 text-sm font-semibold text-coral-400 transition-all hover:border-coral-500/40 hover:bg-coral-500/10"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.72-4.04-1.59-4.04-1.59-.55-1.38-1.34-1.75-1.34-1.75-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.23 1.84 1.23 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.84 0-1.29.47-2.34 1.23-3.17-.12-.3-.53-1.52.12-3.16 0 0 1-.32 3.3 1.21a11.6 11.6 0 0 1 6 0c2.3-1.53 3.3-1.21 3.3-1.21.65 1.64.24 2.86.12 3.16.77.83 1.23 1.88 1.23 3.17 0 4.54-2.81 5.53-5.49 5.83.43.36.81 1.08.81 2.18 0 1.58-.01 2.85-.01 3.24 0 .32.21.7.82.58A12.04 12.04 0 0 0 24 12.29C24 5.78 18.63.5 12 .5Z" /></svg>
        <span data-i18n-es="Ver ai-toolkit en GitHub">View ai-toolkit on GitHub</span>
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </div>
  </div>
</section>
