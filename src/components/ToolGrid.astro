---
import { tools, type Tool } from '../data/content';

const accentMap = {
  wave: { text: 'text-wave-400', bg: 'bg-wave-500/10', border: 'border-wave-500/20', glow: 'shadow-wave-500/20' },
  foam: { text: 'text-foam-400', bg: 'bg-foam-400/10', border: 'border-foam-400/20', glow: 'shadow-foam-400/20' },
  coral: { text: 'text-coral-400', bg: 'bg-coral-500/10', border: 'border-coral-500/20', glow: 'shadow-coral-500/20' },
};
---

<section id="tools" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-wave-400">Ecosistema</span>
      <h2 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Cuatro herramientas, un solo objetivo
      </h2>
      <p class="mt-4 text-lg text-slate-400">
        Cada herramienta resuelve un problema específico. Juntas forman un ecosistema completo
        para automatización de navegador en Python. Sin Node.js, sin descargas de Chromium.
      </p>
    </div>

    <!-- Tool cards -->
    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool, i) => {
        const a = accentMap[tool.accent];
        return (
          <article
            class={`reveal glass group relative flex flex-col rounded-2xl p-6 transition-all duration-300 hover:shadow-2xl ${a.glow} hover:-translate-y-1`}
            style={`transition-delay: ${i * 80}ms;`}
          >
            <!-- Top row: icon + status -->
            <div class="flex items-start justify-between">
              <div class={`flex h-12 w-12 items-center justify-center rounded-xl ${a.bg} ${a.border} border text-2xl`}>
                {tool.icon}
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-foam-400/10 px-3 py-1 text-xs font-medium text-foam-400">
                <span class="h-1.5 w-1.5 rounded-full bg-foam-400"></span>
                Publicado
              </span>
            </div>

            <!-- Name + tagline -->
            <div class="mt-5">
              <h3 class="font-display text-xl font-bold text-white">{tool.name}</h3>
              <p class={`mt-1 text-sm font-medium ${a.text}`}>{tool.tagline}</p>
            </div>

            <!-- Description -->
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-400">
              {tool.description}
            </p>

            <!-- Stats -->
            <div class="mt-4 grid grid-cols-3 gap-2">
              {tool.stats.map((stat) => (
                <div class={`rounded-lg ${a.bg} border ${a.border} px-2 py-1.5 text-center`}>
                  <div class={`font-display text-sm font-bold ${a.text}`}>{stat.value}</div>
                  <div class="text-[10px] font-medium uppercase tracking-wider text-slate-500">{stat.label}</div>
                </div>
              ))}
            </div>

            <!-- Features -->
            <div class="mt-3 flex flex-wrap gap-2">
              {tool.features.map((feat) => (
                <span class={`rounded-md ${a.bg} px-2.5 py-1 text-xs font-medium ${a.text}`}>
                  {feat}
                </span>
              ))}
            </div>

            <!-- Install command -->
            {tool.install && (
              <div class="mt-5 flex items-center gap-2 rounded-lg border border-slate-800 bg-abyss-950/60 px-3 py-2.5 font-mono text-xs text-slate-400">
                <span class="text-foam-400">$</span>
                <span class="truncate">{tool.install}</span>
              </div>
            )}

            <!-- Links -->
            <div class="mt-5 flex items-center gap-4 border-t border-slate-800/50 pt-4">
              <a
                href={tool.repo}
                target="_blank"
                rel="noopener"
                class={`inline-flex items-center gap-1.5 text-sm font-medium ${a.text} transition-opacity hover:opacity-80`}
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.72-4.04-1.59-4.04-1.59-.55-1.38-1.34-1.75-1.34-1.75-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.23 1.84 1.23 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.84 0-1.29.47-2.34 1.23-3.17-.12-.3-.53-1.52.12-3.16 0 0 1-.32 3.3 1.21a11.6 11.6 0 0 1 6 0c2.3-1.53 3.3-1.21 3.3-1.21.65 1.64.24 2.86.12 3.16.77.83 1.23 1.88 1.23 3.17 0 4.54-2.81 5.53-5.49 5.83.43.36.81 1.08.81 2.18 0 1.58-.01 2.85-.01 3.24 0 .32.21.7.82.58A12.04 12.04 0 0 0 24 12.29C24 5.78 18.63.5 12 .5Z" /></svg>
                Repositorio
              </a>
              <a
                href={tool.docs}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition-colors hover:text-wave-400"
              >
                Docs
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
