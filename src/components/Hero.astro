---
const base = import.meta.env.BASE_URL;
---

<section class="relative min-h-screen overflow-hidden">
  <!-- Background layers -->
  <div class="absolute inset-0 grid-pattern opacity-40"></div>

  <!-- Gradient mesh orbs -->
  <div class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-wave-500/20 blur-[120px] animate-glow-pulse"></div>
  <div class="absolute top-20 right-0 h-80 w-80 rounded-full bg-foam-400/15 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>
  <div class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-coral-500/10 blur-[100px] animate-glow-pulse" style="animation-delay: 4s;"></div>

  <!-- Animated wave SVGs -->
  <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
    <svg viewBox="0 0 1440 320" class="w-full h-auto" preserveAspectRatio="none" fill="none">
      <path
        d="M0,160 C240,220 480,100 720,160 C960,220 1200,100 1440,160 L1440,320 L0,320 Z"
        fill="rgba(34, 211, 238, 0.04)"
        style="animation: wave-flow 8s ease-in-out infinite;"
      />
      <path
        d="M0,200 C240,260 480,140 720,200 C960,260 1200,140 1440,200 L1440,320 L0,320 Z"
        fill="rgba(52, 211, 153, 0.03)"
        style="animation: wave-flow-slow 10s ease-in-out infinite;"
      />
      <path
        d="M0,240 C240,280 480,180 720,240 C960,280 1200,180 1440,240 L1440,320 L0,320 Z"
        fill="rgba(34, 211, 238, 0.02)"
        style="animation: wave-flow 12s ease-in-out infinite; animation-delay: 1s;"
      />
    </svg>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto flex min-h-screen max-w-7xl flex-col items-center justify-center px-4 pt-20 pb-32 text-center sm:px-6 lg:px-8">
    <!-- Badge -->
    <div class="animate-float-up mb-8 inline-flex items-center gap-2 rounded-full border border-wave-500/20 bg-wave-500/5 px-4 py-1.5 text-xs font-medium text-wave-400">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-foam-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-foam-400"></span>
      </span>
      <span data-i18n-es="4 herramientas · 1 ecosistema · 100% Python · sin Node.js">4 tools · 1 ecosystem · 100% Python · no Node.js</span>
    </div>

    <!-- Title -->
    <h1 class="animate-float-up max-w-5xl font-display text-5xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl md:text-7xl lg:text-8xl" style="animation-delay: 0.1s;">
      The <span class="text-gradient-wave">Wave</span> ecosystem
      <br class="hidden sm:block" />
      for browser
      <br class="hidden sm:block" />
      automation
    </h1>

    <!-- Subtitle -->
    <p class="animate-float-up mt-8 max-w-2xl text-lg text-slate-400 sm:text-xl" style="animation-delay: 0.2s;" data-i18n-es="De CDP a WebDriver BiDi, de la CLI al control desde LLMs. Sin Node.js, sin descargas de Chromium. Solo Python y tu navegador.">
      From CDP to WebDriver BiDi, from CLI to LLM control.
      No Node.js, no Chromium downloads. Just Python and your browser.
    </p>

    <!-- CTAs -->
    <div class="animate-float-up mt-10 flex flex-col items-center gap-4 sm:flex-row" style="animation-delay: 0.3s;">
      <a
        href="#tools"
        class="group relative inline-flex items-center gap-2 overflow-hidden rounded-xl bg-gradient-to-r from-wave-500 to-foam-400 px-7 py-3.5 text-sm font-semibold text-abyss-950 transition-transform hover:scale-105"
      >
        <span class="absolute inset-0 bg-gradient-to-r from-foam-400 to-wave-500 opacity-0 transition-opacity group-hover:opacity-100"></span>
        <span class="relative" data-i18n-es="Explorar herramientas">Explore tools</span>
        <svg class="relative h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <a
        href="#architecture"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-abyss-800/50 px-7 py-3.5 text-sm font-semibold text-slate-300 transition-colors hover:border-wave-500/30 hover:text-wave-400"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 5V3m8 2V3" />
        </svg>
        <span data-i18n-es="Ver arquitectura">View architecture</span>
      </a>
    </div>

    <!-- Quick install -->
    <div class="animate-float-up mt-12 flex flex-col items-center gap-3" style="animation-delay: 0.4s;">
      <span class="text-xs font-medium uppercase tracking-widest text-slate-500" data-i18n-es="Instalación rápida">Quick install</span>
      <div class="group flex items-center gap-3 rounded-xl border border-slate-800 bg-abyss-900/80 px-5 py-3 font-mono text-sm text-slate-300 backdrop-blur-sm transition-colors hover:border-wave-500/20">
        <span class="text-foam-400">$</span>
        <span>pip install <span class="text-wave-400">wavexis</span></span>
        <button id="copy-btn" class="ml-2 text-slate-500 transition-colors hover:text-wave-400" aria-label="Copy">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Stats -->
    <div class="animate-float-up mt-16 grid grid-cols-2 gap-8 sm:grid-cols-4" style="animation-delay: 0.5s;">
      {[
        { value: '4', label: 'Tools', labelEs: 'Herramientas' },
        { value: '220', label: 'MCP tools', labelEs: 'MCP tools' },
        { value: '743', label: 'CLI methods', labelEs: 'Métodos CLI' },
        { value: 'W3C', label: 'Open standard', labelEs: 'Estándar abierto' },
      ].map((stat) => (
        <div class="text-center">
          <div class="font-display text-3xl font-bold text-white sm:text-4xl">{stat.value}</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wider text-slate-500" data-i18n-es={stat.labelEs}>{stat.label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-glow-pulse">
    <svg class="h-6 w-6 text-wave-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<script>
  document.getElementById('copy-btn')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('pip install wavexis');
      const btn = document.getElementById('copy-btn');
      if (btn) {
        btn.style.color = '#34d399';
        setTimeout(() => { btn.style.color = ''; }, 1500);
      }
    } catch {}
  });
</script>
