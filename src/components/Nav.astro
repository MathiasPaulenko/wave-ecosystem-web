---
const base = import.meta.env.BASE_URL;
const links = [
  { href: '#tools', label: 'Tools', labelEs: 'Herramientas' },
  { href: '#compare', label: 'Compare', labelEs: 'Comparativa' },
  { href: '#usecases', label: 'Use Cases', labelEs: 'Casos de uso' },
  { href: '#architecture', label: 'Architecture', labelEs: 'Arquitectura' },
  { href: '#roadmap', label: 'Roadmap', labelEs: 'Roadmap' },
];
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href={`${base}`} class="flex items-center gap-2.5 group">
        <svg class="h-8 w-8 transition-transform group-hover:scale-110" viewBox="0 0 256 256" fill="none">
          <defs>
            <linearGradient id="nav-logo-bg" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#22d3ee"/>
              <stop offset="100%" stop-color="#0e7490"/>
            </linearGradient>
          </defs>
          <rect x="8" y="8" width="240" height="240" rx="56" ry="56" fill="url(#nav-logo-bg)"/>
          <path d="M 56 100 Q 88 60 120 100 T 184 100 T 200 100" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" opacity="0.4"/>
          <path d="M 56 128 Q 88 88 120 128 T 184 128 T 200 128" fill="none" stroke="#FFFFFF" stroke-width="10" stroke-linecap="round"/>
          <g transform="translate(128, 186)" opacity="0.9">
            <line x1="-40" y1="0" x2="-14" y2="0" stroke="#FFFFFF" stroke-width="3" opacity="0.5"/>
            <line x1="-6" y1="0" x2="6" y2="0" stroke="#FFFFFF" stroke-width="3" opacity="0.5"/>
            <line x1="14" y1="0" x2="40" y2="0" stroke="#FFFFFF" stroke-width="3" opacity="0.5"/>
            <circle cx="-40" cy="0" r="8" fill="#FFFFFF"/>
            <circle cx="-13" cy="0" r="8" fill="#FFFFFF"/>
            <circle cx="13" cy="0" r="8" fill="#FFFFFF"/>
            <circle cx="40" cy="0" r="8" fill="#FFFFFF"/>
          </g>
        </svg>
        <span class="font-display text-lg font-extrabold tracking-tight">
          <span class="text-white">Wave</span><span class="text-wave-400">Ecosystem</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden items-center gap-1 md:flex">
        {links.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3.5 py-2 text-sm font-medium text-slate-400 transition-colors hover:text-wave-400 hover:bg-wave-500/5"
            data-i18n-es={link.labelEs}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="flex items-center gap-3">
        <!-- Language toggle -->
        <button
          id="lang-toggle"
          class="flex items-center gap-1 rounded-lg border border-slate-700 bg-abyss-800/50 px-2.5 py-1.5 text-xs font-semibold text-slate-400 transition-colors hover:border-wave-500/30 hover:text-wave-400"
          aria-label="Switch language"
        >
          <span data-lang-current>EN</span>
          <span class="text-slate-600">/</span>
          <span data-lang-other class="text-slate-600">ES</span>
        </button>
        <a
          href="https://github.com/MathiasPaulenko/wave-ecosystem-web#readme"
          target="_blank"
          rel="noopener"
          class="hidden items-center gap-2 rounded-lg border border-wave-500/20 bg-wave-500/5 px-4 py-2 text-sm font-medium text-wave-400 transition-all hover:border-wave-500/40 hover:bg-wave-500/10 sm:flex"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.72-4.04-1.59-4.04-1.59-.55-1.38-1.34-1.75-1.34-1.75-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.23 1.84 1.23 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.84 0-1.29.47-2.34 1.23-3.17-.12-.3-.53-1.52.12-3.16 0 0 1-.32 3.3 1.21a11.6 11.6 0 0 1 6 0c2.3-1.53 3.3-1.21 3.3-1.21.65 1.64.24 2.86.12 3.16.77.83 1.23 1.88 1.23 3.17 0 4.54-2.81 5.53-5.49 5.83.43.36.81 1.08.81 2.18 0 1.58-.01 2.85-.01 3.24 0 .32.21.7.82.58A12.04 12.04 0 0 0 24 12.29C24 5.78 18.63.5 12 .5Z" /></svg>
          GitHub
        </a>
        <!-- Mobile menu button -->
        <button id="menu-btn" class="md:hidden rounded-lg p-2 text-slate-400 hover:text-wave-400" aria-label="Menu">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-wave-500/10 bg-abyss-900/95 backdrop-blur-lg md:hidden">
    <div class="space-y-1 px-4 py-3">
      {links.map((link) => (
        <a href={link.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-400 hover:bg-wave-500/5 hover:text-wave-400" data-i18n-es={link.labelEs}>
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const langToggle = document.getElementById('lang-toggle');

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('border-b', 'border-wave-500/10', 'bg-abyss-950/80', 'backdrop-blur-lg');
    } else {
      navbar?.classList.remove('border-b', 'border-wave-500/10', 'bg-abyss-950/80', 'backdrop-blur-lg');
    }
  });

  // Mobile menu toggle
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Language toggle
  langToggle?.addEventListener('click', () => {
    window.dispatchEvent(new Event('i18n-toggle'));
  });
</script>
