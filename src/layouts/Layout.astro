---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Wave Ecosystem — Browser Automation for Python',
  description = 'A unified ecosystem of Python tools for browser automation: CDP, WebDriver BiDi, testing framework, MCP for LLMs and CLI.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500;700&family=Unbounded:wght@400;600;800;900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-abyss-950 text-slate-200 antialiased">
    <div class="noise-overlay"></div>
    <slot />
  </body>
</html>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

  // i18n language switching
  function applyLang(lang: string) {
    document.documentElement.lang = lang;
    localStorage.setItem('wave-lang', lang);

    document.querySelectorAll('[data-i18n-es]').forEach((el) => {
      const elem = el as HTMLElement;
      if (lang === 'es') {
        if (!elem.dataset.i18nEn) elem.dataset.i18nEn = elem.textContent ?? '';
        elem.textContent = elem.dataset.i18nEs ?? '';
      } else {
        if (elem.dataset.i18nEn) elem.textContent = elem.dataset.i18nEn;
      }
    });

    // Update toggle button labels
    document.querySelectorAll('[data-lang-current]').forEach((el) => {
      (el as HTMLElement).textContent = lang === 'en' ? 'EN' : 'ES';
    });
    document.querySelectorAll('[data-lang-other]').forEach((el) => {
      (el as HTMLElement).textContent = lang === 'en' ? 'ES' : 'EN';
    });
  }

  // Apply saved language on load
  const savedLang = localStorage.getItem('wave-lang') || 'en';
  applyLang(savedLang);

  // Listen for toggle events
  window.addEventListener('i18n-toggle', () => {
    const current = document.documentElement.lang;
    applyLang(current === 'en' ? 'es' : 'en');
  });
</script>
